{
  "name": "algoneo",
  "version": "1.0.0",
  "private": true,
  "description": "AlgoNeo Automated Options Trading & Backtesting Terminal",
  "scripts": {
    "update": "git pull origin master && sudo systemctl restart algo.service",
    "check": "python scripts/preflight_check.py",
    "sync": "bash scripts/sync_trades.sh",
    "setup:sync": "bash scripts/setup_sync_service.sh",
    "setup:services": "bash scripts/setup_services.sh",
    "setup:runner": "bash scripts/setup_github_runner.sh",
    "restart": "sudo systemctl restart algo.service",
    "status": "sudo systemctl status algo.service",
    "logs": "sudo journalctl -u algo.service -f -n 50",
    "stop": "sudo systemctl stop algo.service",
    "build": "npm --prefix web run build",
    "setup": "python -m pip install -r requirements.txt && npm --prefix web install",
    "server": "python app_server.py",
    "start": "bash scripts/start.sh"
  }
}
