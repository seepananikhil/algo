
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Build static UI",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: app server",
      "type": "shell",
      "command": "/c/Users/hp/AppData/Local/Programs/Python/Python312/python.exe",
      "args": [
        "-u",
        "app_server.py"
      ],
      "dependsOn": ["Frontend: Build static UI"],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Open app in browser",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "start", "http://127.0.0.1:8090/day"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Full stack: start app",
      "dependsOn": ["Backend: app server"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
