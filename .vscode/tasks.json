{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: app server",
      "type": "shell",
      "command": "python",
      "args": [
        "app_server.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Vite UI",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev",
        "--",
        "--host",
        "0.0.0.0"
      ],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Open app in browser",
      "type": "shell",
      "command": "cmd /c start http://localhost:5173",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Full stack: start app",
      "dependsOn": [
        "Backend: app server",
        "Frontend: Vite UI"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
