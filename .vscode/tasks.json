{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start All Paper Trading & Live Feed",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/d", "/c", "start_all_paper.bat"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "🛑 Stop All Paper Trading Services",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/d", "/c", "stop_all_paper.bat"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "📊 Start Dashboard Server (Web UI)",
      "type": "shell",
      "command": "python",
      "args": ["-u", "app_server.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "📡 Start Kotak Live Market Feed",
      "type": "shell",
      "command": "python",
      "args": ["-u", "kotak_capture.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "📈 Run Nifty Trend Runner Paper",
      "type": "shell",
      "command": "python",
      "args": ["-u", "trend_runner_paper.py", "--symbol", "NIFTY", "--poll", "5"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "📈 Run Sensex Trend Runner Paper",
      "type": "shell",
      "command": "python",
      "args": ["-u", "trend_runner_paper.py", "--symbol", "SENSEX", "--poll", "5"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "🔄 Fetch Today's Weekly Options (Nifty & Sensex)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "python scripts/fetch_weekly_options.py --index NIFTY; python scripts/fetch_weekly_options.py --index SENSEX"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "📊 Re-run 10-Year Master Backtests",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "python run_10y_backtest.py; python run_sensex_multiyear_trend_backtest.py; python run_10y_midpoint_backtest.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "📦 Rebuild Options Parquet Catalogs (DuckDB)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "cd options_data/nifty; python -c 'import duckdb; con=duckdb.connect(); con.execute(open(\"scripts/build_parquet.sql\").read())'; cd ../sensex; python -c 'import duckdb; con=duckdb.connect(); con.execute(open(\"scripts/build_parquet.sql\").read())'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "🌐 Build Static UI (Frontend)",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false,
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
